{
  "name": "@tsnx/data",
  "version": "1.2.0",
  "description": "TSNX Data Abstractions - EF Core inspired DbContext, Unit of Work, Repository, and DI integration for TSNX",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "!dist/__tests__",
    "!dist/**/*.tsbuildinfo",
    "!dist/**/*.map",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -b",
    "clean": "tsc -b --clean",
    "typecheck": "tsc -b --noEmit",
    "test": "node --test dist/__tests__"
  },
  "dependencies": {
    "@tsnx/hosting-abstractions": "^2.0.0-rc.2"
  },
  "devDependencies": {
    "@types/node": "^22.13.9",
    "@tsnx/hosting": "^2.0.0-rc.2"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/tsnxjs/data.git",
    "directory": "packages/data"
  },
  "bugs": "https://github.com/tsnxjs/data/issues",
  "homepage": "https://github.com/tsnxjs/data#readme"
}
